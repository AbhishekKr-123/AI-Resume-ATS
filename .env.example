SUPABASE_URL=your_project_url
# Must start with sb_publishable_ (or be the legacy anon key), never sb_secret_.
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Streamlit reads this URL; it contains no secret.
API_BASE_URL=http://127.0.0.1:8000
# Must exactly match an allowed Supabase Redirect URL for Google OAuth.
FRONTEND_REDIRECT_URL=http://localhost:8501
# Browser-facing FastAPI origin. Keep the hostname consistent with Streamlit;
# do not mix localhost and 127.0.0.1 for browser OAuth/cookie traffic.
AUTH_PUBLIC_URL=http://localhost:8000
# Exact comma-separated post-authentication destinations. No wildcard matching.
AUTH_ALLOWED_REDIRECT_URLS=http://localhost:8501
# Local HTTP only. Production HTTPS deployments must set this to true.
AUTH_COOKIE_SECURE=false
# Process-local session expiration and access-token refresh safety window.
AUTH_SESSION_IDLE_SECONDS=86400
AUTH_SESSION_ABSOLUTE_SECONDS=604800
AUTH_REFRESH_SKEW_SECONDS=60
# Server-only. Never copy this into SUPABASE_PUBLISHABLE_KEY or a Streamlit environment.
# It is not used by user-scoped CRUD in this application.
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_TIMEOUT_SECONDS=15

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=your_available_model_id
GROQ_TIMEOUT_SECONDS=20

# Phase 2 document-ingestion limits. Values are bytes except MAX_PDF_PAGES
# and MAX_DOCX_ZIP_ENTRIES.
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=20
MAX_PDF_DECODED_STREAM_BYTES=10485760
MAX_EXTRACTED_TEXT_CHARS=200000
MAX_DOCX_ZIP_ENTRIES=200
MAX_DOCX_TOTAL_UNCOMPRESSED_BYTES=20971520
MAX_DOCX_ENTRY_UNCOMPRESSED_BYTES=5242880
MAX_JOB_DESCRIPTION_CHARS=20000

# Process-local protection for expensive model/Groq analysis requests. Use an
# upstream shared limiter when running multiple backend instances.
ANALYSIS_RATE_LIMIT_REQUESTS=30
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=60

# Deterministic Phase 3 ATS scoring weights; must be non-negative and total 100.
SEMANTIC_WEIGHT=35
TECHNICAL_SKILLS_WEIGHT=25
KEYWORDS_WEIGHT=15
EXPERIENCE_RELEVANCE_WEIGHT=15
FORMATTING_COMPLETENESS_WEIGHT=10
